# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# ssh deploy keys — never commit these, generate on your own machine
# and install the public half on the server. See scripts/deploy.sh.
deploy_key
deploy_key.pub
*.pem
id_ed25519*
id_rsa*

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
